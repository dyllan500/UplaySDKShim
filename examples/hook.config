# Common networking policy. Copy this next to the game-specific shim DLL.
redirect_ip=192.168.1.10
bypass_tls_verify=1
# rva_tls_verify=0x00000000
# tls_verify_stack_bytes=0

# FC4 discovery aid do not leave this enabled after identifying hosts.
redirect_all_dns=0

# Diagnostics (implemented only by the applicable game adapter).
capture_tcp=0
log_rdv_full=0
log_tcp_full=0
capture_ssl=0
capture_uplay=0
trace_uplay=0
dump_session_blob=0
trace_getprocaddr=0
trace_cng=0
trace_cng_payload=0
trace_game_log=0
dump_module=0
